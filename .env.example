# ── Master bot ────────────────────────────────────────────────────────────
# Token from @BotFather for the MASTER bot (shop tokens are added at runtime)
BOT_TOKEN=your_master_bot_token_here

# Your Telegram user ID (get it from @userinfobot)
SUPER_ADMIN_ID=123456789

# ── Infrastructure ────────────────────────────────────────────────────────
# postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/teleshop
REDIS_URL=redis://localhost:6379/0

# ── Pricing (Telegram Stars) ──────────────────────────────────────────────
SUBSCRIPTION_PRICE_STARS=1200
SUBSCRIPTION_DAYS=365
# Free trial length in days (shop is live, unpaid, for this long)
TRIAL_DAYS=30

# ── Web dashboard ─────────────────────────────────────────────────────────
# Public URL of the dashboard — MUST match the domain you set in @BotFather
# with /setdomain for the master bot, or Telegram login will not work.
WEB_BASE_URL=https://shop.example.com
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Random string; signs dashboard session cookies
WEB_SESSION_SECRET=change-me-to-a-long-random-string

# ── Affiliate program ─────────────────────────────────────────────────────
AFFILIATE_COMMISSION_CREDITS=300
AFFILIATE_PAYOUT_THRESHOLD=1300
AFFILIATE_PAYMENT_AMOUNT=1300

# ── Misc ──────────────────────────────────────────────────────────────────
DEFAULT_CURRENCY=ETB
LOG_LEVEL=INFO
LOG_DIR=logs
